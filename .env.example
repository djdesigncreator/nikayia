# Servidor
PORT=4000
NODE_ENV=development

# Base de dados
DATABASE_URL="postgresql://user:password@localhost:5432/nikayia"

# Bubble.io (autenticação)
# Se o Bubble assinar tokens com um segredo partilhado:
BUBBLE_JWT_SECRET=
# Se o Bubble expuser um endpoint JWKS para validação (alternativa mais segura):
BUBBLE_JWKS_URL=

# Bunny.net (storage + CDN)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_REGION=
BUNNY_CDN_HOSTNAME=

# Agora.io (live streaming)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRATION_SECONDS=3600

# Geral
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
